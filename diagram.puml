        +login(...) : Optional<User>
    }
}

' ---- CONTROLLER ----
package "Controller" #fff0f0 {
    class TransactionController {
        +getAll(userId : Long) : ResponseEntity
        +addIncome(...) : ResponseEntity
        +addExpense(...) : ResponseEntity
        +update(...) : ResponseEntity
        +delete(id : Long) : ResponseEntity
        +filter(...) : ResponseEntity
    }
    class CategoryController {
        +getAll() : ResponseEntity
        +add(...) : ResponseEntity
        +delete(id : Long) : ResponseEntity
    }
    class ReportController {
        +getMonthlyReport(...) : ResponseEntity
    }
    class UserController {
        +register(...) : ResponseEntity
        +login(...) : ResponseEntity
    }
}

' ---- RELATIONS ----

' Inheritance
Transaction <|-- Income  : extends
Transaction <|-- Expense : extends

' Interface implementation
TransactionRepository ..|> IRepository : implements
CategoryRepository    ..|> IRepository : implements
