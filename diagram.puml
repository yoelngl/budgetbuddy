' ===========================================================
@startuml 04_Controller_Layer

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #FEFEFE
    BorderColor     #2d6a9f
    ArrowColor      #1e3a5f
    FontSize        13
}
skinparam linetype ortho

title BudgetBuddy — Diagram 4: Controller Layer

' Referenced service classes (simplified)
class TransactionService {
    +addIncome(...) : Transaction
    +addExpense(...) : Transaction
    +getAllTransactions(userId : Long) : List<Transaction>
    +updateTransaction(...) : Transaction
    +deleteTransaction(id : Long) : boolean
    +filterByCategory(...) : List<Transaction>
    +filterByDateRange(...) : List<Transaction>
    +filterByType(...) : List<Transaction>
    +searchByKeyword(...) : List<Transaction>
}
class CategoryService {
    +getAllCategories() : List<Category>
    +addCategory(...) : Category
    +deleteCategory(id : Long) : boolean
}
class ReportService {
    +generateMonthlyReport(userId : Long,\n  month : int, year : int) : MonthlyReport
}
class UserService {
    +register(...) : User
    +login(...) : Optional<User>
}

' REST Controllers
class TransactionController {
    -transactionService : TransactionService
    --
    +getAll(userId : Long) : ResponseEntity
    +addIncome(userId : Long, body : Map) : ResponseEntity
    +addExpense(userId : Long, body : Map) : ResponseEntity
    +update(id : Long, body : Map) : ResponseEntity
    +delete(id : Long) : ResponseEntity
    +filter(userId : Long, categoryId : Long,\n  startDate : String, endDate : String,\n  type : String, keyword : String) : ResponseEntity
}

class CategoryController {
    -categoryService : CategoryService
    --
    +getAll() : ResponseEntity
    +add(body : Map) : ResponseEntity
    +delete(id : Long) : ResponseEntity
}

class ReportController {
    -reportService : ReportService
    --
    +getMonthlyReport(userId : Long,\n  month : int, year : int) : ResponseEntity
}

class UserController {
    -userService : UserService
    --
    +register(body : Map) : ResponseEntity
    +login(body : Map) : ResponseEntity
}

' Dependencies
TransactionController --> TransactionService : calls >
CategoryController    --> CategoryService    : calls >
ReportController      --> ReportService      : calls >
UserController        --> UserService        : calls >

@enduml


