        -totalIncome : double
        -totalExpense : double
        --
        +generate(List<Transaction>) : void
        +getBalance() : double
    }
}

' ---- REPOSITORY ----
package "Repository" #f0fff0 {
    interface "IRepository<T>" as IRepository <<interface>> {
        +save(entity : T) : T
        +findAll() : List<T>
        +findById(id : Long) : Optional<T>
        +delete(id : Long) : boolean
        +update(entity : T) : T
    }
    class TransactionRepository {
        +save(t : Transaction) : Transaction
        +findByUserId(userId : Long) : List<Transaction>
        +findByUserIdAndDateRange(...) : List<Transaction>
    }
    class CategoryRepository {
        +save(c : Category) : Category
        +findAll() : List<Category>
    }
    class UserRepository {
        +save(u : User) : User
        +findByUsername(username : String) : Optional<User>
    }
}

' ---- SERVICE ----
package "Service" #fffff0 {
