@startuml 05_Full_Overview

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #FEFEFE
    BorderColor     #2d6a9f
    ArrowColor      #1e3a5f
    FontSize        11
}
skinparam stereotypeCBackgroundColor #d4e8ff
skinparam stereotypeABackgroundColor #ffe5cc
skinparam stereotypeIBackgroundColor #d4ffd4
skinparam linetype ortho

title BudgetBuddy — Diagram 5: Full Overview

' ---- MODEL ----
package "Model" #f0f8ff {
    abstract class Transaction <<abstract>> {
        -id : Long
        -amount : double
        -date : LocalDate
        -description : String
        -userId : Long
        --
        +{abstract} getType() : String
        +getId() : Long
        +getAmount() : double
        +getDate() : LocalDate
        +getDescription() : String
        +getUserId() : Long
    }
    class Income {
        -source : String
        --
        +getSource() : String
        +getType() : String
    }
    class Expense {
        -categoryId : Long
        -categoryName : String
        --
        +getCategoryId() : Long
        +getCategoryName() : String
        +getType() : String
    }
    class Category {
        -id : Long
        -name : String
        -description : String
        --
        +getId() : Long
        +getName() : String
    }
    class User {
        -id : Long
        -username : String
        -email : String
        -password : String
        --
